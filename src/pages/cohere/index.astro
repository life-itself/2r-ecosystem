---
import { getCollection } from 'astro:content';
import ProfileSearch from '../../components/ProfileSearch';
import Base from '../../layouts/Base.astro';
import { toInteractiveProfile } from '../../lib/interactive-server';

const profiles = (await getCollection('cohere'))
  .map((profile) =>
    toInteractiveProfile({ collection: 'cohere', id: profile.id, data: profile.data }),
  )
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base
  title="Cohere+ Profiles | Second Renaissance Ecosystem"
  description="Cohere+ ecosystem profiles loaded from the root-level markdown collection."
>
  <h1>Cohere+ Profiles</h1>
  <p class="lede">
    Project profiles from the Cohere+ mapping, loaded from the existing
    root-level markdown collection.
  </p>

  <div class="stat">
    <strong>{profiles.length}</strong>
    <span>profiles loaded</span>
  </div>

  <ProfileSearch
    profiles={profiles}
    primaryLabel="Sector"
    secondaryLabel="Activity"
    client:load
  />
</Base>

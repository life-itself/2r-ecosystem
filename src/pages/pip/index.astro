---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const profiles = (await getCollection('pip'))
  .filter((profile) => ['Y', 'YY'].includes(String(profile.data.curation_status ?? '')))
  .sort((a, b) => String(a.data.title ?? a.id).localeCompare(String(b.data.title ?? b.id)));

const sampleProfiles = profiles.slice(0, 24);
---

<Base
  title="PIP Profiles | Second Renaissance Ecosystem"
  description="PIP ecosystem profiles loaded from the root-level markdown collection."
>
  <h1>PIP Profiles</h1>
  <p class="lede">
    Paradigmatic, Integrative, and Pragmatic ecosystem profiles. This page
    verifies that Astro is reading the existing root-level markdown collection.
  </p>

  <div class="stat">
    <strong>{profiles.length}</strong>
    <span>curated profiles loaded</span>
  </div>

  <h2>Sample Profiles</h2>
  <ul class="profile-list">
    {
      sampleProfiles.map((profile) => (
        <li>{String(profile.data.title ?? profile.id)}</li>
      ))
    }
  </ul>
</Base>

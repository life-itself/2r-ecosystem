---
import { getCollection } from 'astro:content';
import ProfileSearch from '../../components/ProfileSearch';
import Base from '../../layouts/Base.astro';
import { toInteractiveProfile } from '../../lib/interactive-server';
import { isCuratedPipProfile } from '../../lib/profile';

const profiles = (await getCollection('pip'))
  .filter((profile) => isCuratedPipProfile(profile.data))
  .map((profile) =>
    toInteractiveProfile({ collection: 'pip', id: profile.id, data: profile.data }),
  )
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base
  title="PIP Directory | Second Renaissance Ecosystem"
  description="Directory of organizations taking paradigmatic, integrative, and pragmatic approaches to social change."
>
  <a class="back-link" href="/pip/">← PIP Mapping</a>
  <h1>PIP Directory</h1>
  <p class="lede">
    Paradigmatic, Integrative, and Pragmatic — a directory of organizations
    and initiatives active in this emerging ecosystem.
  </p>

  <div class="stat">
    <strong>{profiles.length}</strong>
    <span>curated profiles loaded</span>
  </div>

  <a class="section-link" href="/pip/map/">Explore PIP visual maps</a>

  <ProfileSearch
    profiles={profiles}
    primaryLabel="Topic"
    secondaryLabel="Activity"
    client:load
  />
</Base>

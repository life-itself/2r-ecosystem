---
import Base from '../layouts/Base.astro';
---

<Base
  title="Second Renaissance Ecosystem Mapping"
  description="Mapping an emerging ecosystem of change agents working on paradigmatic, integrative, and pragmatic approaches to social change."
>
  <section class="landing-hero">
    <div>
      <p class="landing-kicker">Ecosystem catalog</p>
      <h1>Second Renaissance Ecosystem Mapping</h1>
      <p class="lede">
        Mapping an emerging ecosystem of change agents working on paradigmatic,
        integrative, and pragmatic approaches to social change.
      </p>
      <div class="landing-actions">
        <a class="button primary" href="/pip/">Browse PIP</a>
        <a class="button" href="/cohere/">Browse Cohere+</a>
      </div>
    </div>
    <aside class="landing-panel">
      <img
        src="/assets/img/ecosystem/second-renaissance-ecosystem-map.webp"
        alt="Second Renaissance ecosystem map"
      />
      <div class="landing-panel-body">
        <p>
          Profiles, directories, and visualizations from ecosystem mapping work
          across the Second Renaissance field.
        </p>
      </div>
    </aside>
  </section>

  <div class="section-heading">
    <div>
      <p class="landing-kicker">Mappings</p>
      <h2>Browse the collections</h2>
    </div>
    <p>
      Start with separate catalogs for each mapping effort. A unified directory
      can come later once the underlying data is stable.
    </p>
  </div>
  <div class="grid">
    <a class="card" href="/pip/">
      <img
        src="/assets/img/ecosystem/second-renaissance-ecosystem-map.webp"
        alt="PIP ecosystem map"
      />
      <div class="card-body">
        <h3>PIP Ecosystem Map</h3>
        <p>
          Profiles of organizations and initiatives taking paradigmatic,
          integrative, and pragmatic approaches to social change.
        </p>
      </div>
    </a>

    <a class="card" href="/cohere/">
      <img src="/assets/mandala-systems-change.png" alt="Cohere+ profiles" />
      <div class="card-body">
        <h3>Cohere+ Profiles</h3>
        <p>
          Profiles of projects and organizations in the broader ecosystem of
          transformative social change.
        </p>
      </div>
    </a>
  </div>
</Base>

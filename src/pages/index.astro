---
import { getCollection } from 'astro:content';
import NetworkFigure from '../components/NetworkFigure.astro';
import SectionHead from '../components/SectionHead.astro';
import Base from '../layouts/Base.astro';
import { compareDirectoryProfiles } from '../lib/directory-sort';
import { toInteractiveProfile } from '../lib/interactive-server';
import { isCuratedPipProfile } from '../lib/profile';

const pipProfiles = (await getCollection('pip'))
  .filter((profile) => isCuratedPipProfile(profile.data))
  .map((profile) =>
    toInteractiveProfile({ collection: 'pip', id: profile.id, data: profile.data }),
  )
  .sort((a, b) => a.title.localeCompare(b.title));

const cohereProfiles = (await getCollection('cohere'))
  .map((profile) =>
    toInteractiveProfile({ collection: 'cohere', id: profile.id, data: profile.data }),
  )
  .sort((a, b) => a.title.localeCompare(b.title));

const oraProfiles = (await getCollection('ora'))
  .map((profile) =>
    toInteractiveProfile({ collection: 'ora', id: profile.id, data: profile.data as Record<string, unknown> }),
  );

const allProfiles = [...pipProfiles, ...cohereProfiles];
const totalProfileCount = allProfiles.length + oraProfiles.length;
const topics = new Set(allProfiles.flatMap((profile) => profile.facetPrimary));
const activities = new Set(allProfiles.flatMap((profile) => profile.facetSecondary));
const previewProfiles = [...pipProfiles].sort((a, b) => compareDirectoryProfiles(a, b, 'az')).slice(0, 12);

const mappingReports = [
  {
    href: '/state-of-sensemaking-2020/',
    title: 'State of Sensemaking',
    description: 'The first phase of Life Itself\'s ecosystem mapping: research questions, analysis, and a report on an emerging ecosystem of change agents.',
    meta: 'Report · 2020',
  },
  {
    href: '/pip/',
    title: 'PIP Mapping Report',
    description: 'Research and profiles mapping paradigmatic, integrative, and pragmatic organisations driving systems change.',
    meta: 'Report · 2021–2022',
  },
  {
    href: '/ora/',
    title: 'ORA Polycrisis Mapping',
    description: 'A prototype directory of ~90 organisations responding to the polycrisis, primarily in the global south, with reflections on the mapping process.',
    meta: 'Report · 2023',
  },
  {
    href: '/cohere/',
    title: 'Cohere+ Mapping',
    description: 'Profiles and analysis from the EU Erasmus+-funded mapping of paradigmatic social change organisations in Europe.',
    meta: 'Report · 2022–2025',
  },
  {
    href: 'https://secondrenaissance.net/map',
    title: 'Second Renaissance Map',
    description: 'An interactive map of the second renaissance ecosystem.',
    meta: 'Map · external',
  },
];

const updates = [
  {
    href: '/site-update-june-2026/',
    title: 'Five Years of Mapping an Emerging Movement — Now in One Place',
    description: 'The consolidated hub, redesigned site, and the story behind bringing five years of research together.',
    meta: 'Announcement · June 2026',
  },
  {
    href: '/ora-directory-announcement/',
    title: 'The ORA Polycrisis Directory Is Now Public',
    description: '46 organisations working on global polycrisis response, with a focus on the Global South — published for the first time.',
    meta: 'Announcement · June 2026',
  },
];

const essays = [
  {
    href: '/why/',
    title: 'Why ecosystem mapping?',
    description: 'The purpose, boundaries, and research posture behind this open field map.',
    meta: 'Essay',
  },
  {
    href: '/sensemaking/',
    title: 'Mapping as Sensemaking',
    description: 'Our methodology: wiki over database, quality over categorisation, share early and often.',
    meta: 'Note',
  },
  {
    href: 'https://lifeitself.org/blog/mapping-for-emergence',
    title: 'Mapping for Emergence',
    description: 'How ecosystem mapping supports collective intelligence and field-building.',
    meta: 'Essay · 2021 · external',
  },
  {
    href: '/related-efforts/',
    title: 'Related mapping efforts',
    description: 'Adjacent directories, research projects, and ecosystem maps in the field.',
    meta: 'Index',
  },
];

function mono(profile: (typeof allProfiles)[number]) {
  return profile.title
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase())
    .join('');
}
---

<Base
  title="Second Renaissance Ecosystem Mapping"
  description="Nearly 500 profiles of organisations working on civilisational transition, polycrisis response, and societal transformation — five years of ecosystem mapping consolidated in one place."
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="label tick">Ecosystem mapping · open research</p>
        <h1>Mapping a Second Renaissance.</h1>
        <p class="lead">
          Exploring an emerging ecosystem of organisations and movements working
          to transform society from the inside out.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/pip/directory/">
            Browse the directory <span class="arw" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/pip/map/">Explore the map</a>
        </div>
        <div class="meta-strip" aria-label="Ecosystem statistics">
          <div class="m">
            <div class="n">{totalProfileCount}</div>
            <div class="l">Profiles</div>
          </div>
          <div class="m">
            <div class="n">3</div>
            <div class="l">Mappings</div>
          </div>
          <div class="m">
            <div class="n">{topics.size}</div>
            <div class="l">Topics</div>
          </div>
          <div class="m">
            <div class="n">{activities.size}</div>
            <div class="l">Activities</div>
          </div>
        </div>
        <p class="hero-sub">
          Polycrisis · Metacrisis · Civilisational Renewal — five years of fieldwork so you don't navigate this landscape alone.
        </p>
      </div>
      <NetworkFigure />
    </div>
  </section>

  <section class="pip">
    <SectionHead
      number="01"
      label="Framing"
      title="Paradigmatic, integrative, pragmatic."
      description="The PIP frame keeps multiple forms of transformation visible without forcing them into one method or ideology."
    />
    <div class="pip-grid">
      <div class="pip-cell">
        <div class="n">P / 01</div>
        <h3>Paradigmatic</h3>
        <p>
          Work that shifts worldview, meaning, culture, and the premises from
          which social change becomes thinkable.
        </p>
      </div>
      <div class="pip-cell">
        <div class="n">I / 02</div>
        <h3>Integrative</h3>
        <p>
          Work that connects domains, practices, communities, and scales so the
          field can act with more coherence.
        </p>
      </div>
      <div class="pip-cell">
        <div class="n">P / 03</div>
        <h3>Pragmatic</h3>
        <p>
          Work that builds institutions, tools, projects, and concrete pathways
          for social and ecological transition.
        </p>
      </div>
    </div>
  </section>

  <section class="collections">
    <SectionHead
      number="02"
      label="Mappings"
      title="Browse the collections."
      description="Three complementary views into organisations, initiatives, and research across the field."
    />
    <div class="coll-grid">
      <a class="coll" href="/pip/">
        <div class="top">
          <span class="tag">PIP ecosystem</span>
          <span class="count">{pipProfiles.length}</span>
        </div>
        <h3>PIP Ecosystem Map</h3>
        <p>
          ~100 organisations taking paradigmatic, integrative, and pragmatic
          approaches to civilisational change — with interactive visualisations
          and a full research essay.
        </p>
        <span class="go">Explore <span class="arw" aria-hidden="true">→</span></span>
      </a>
      <a class="coll" href="/cohere/">
        <div class="top">
          <span class="tag">Cohere+</span>
          <span class="count">{cohereProfiles.length}</span>
        </div>
        <h3>Cohere+ Profiles</h3>
        <p>
          ~300 projects and organisations in the European transformative change
          ecosystem, compiled for the EU-funded Cohere+ project.
        </p>
        <span class="go">Explore <span class="arw" aria-hidden="true">→</span></span>
      </a>
      <a class="coll" href="/ora/directory/">
        <div class="top">
          <span class="tag">ORA · Polycrisis</span>
          <span class="count">{oraProfiles.length}</span>
        </div>
        <h3>ORA Polycrisis Directory</h3>
        <p>
          40+ organisations working on global polycrisis response, with a focus
          on the Global South. Published here for the first time.
        </p>
        <span class="go">Explore <span class="arw" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="directory">
    <SectionHead
      number="03"
      label="Directory"
      title="Sample the field."
      description="A curated preview from the PIP directory. Use the full directory for search and faceted browsing."
    />
    <div class="filters" aria-hidden="true">
      <span class="flabel">Topics</span>
      {
        [...topics].slice(0, 5).map((topic) => (
          <span class="chip">
            {topic}
          </span>
        ))
      }
    </div>
    <div class="org-grid">
      {
        previewProfiles.map((profile) => (
          <a class="org" href={profile.href}>
            <span class="logo">{mono(profile)}</span>
            <div>
              {profile.facetPrimary[0] && <div class="topic">{profile.facetPrimary[0]}</div>}
              <h4>{profile.title}</h4>
              {profile.facetSecondary.length > 0 && (
                <div class="acts">
                  {profile.facetSecondary.slice(0, 3).map((activity) => (
                    <span class="act">{activity}</span>
                  ))}
                </div>
              )}
            </div>
            {profile.location && <div class="loc">{profile.location}</div>}
          </a>
        ))
      }
    </div>
    <div class="dir-foot">
      <span class="ct">Showing {previewProfiles.length} of {pipProfiles.length} PIP organisations</span>
      <a class="btn btn-ghost" href="/pip/directory/">Full directory</a>
    </div>
  </section>

  <section class="reports" id="reports">
    <SectionHead
      number="04"
      label="Reports & Essays"
      title="Read the research."
      description="Mapping reports, analytical essays, and contextual reading on ecosystem mapping and the second renaissance field."
    />
    <div class="rgroup-label">Latest Updates</div>
    <div class="rlist">
      {
        updates.map((update, index) => (
          <a class="r" href={update.href}>
            <span class="rn">{String(index + 1).padStart(3, '0')}</span>
            <span>
              <span class="rt">{update.title}</span>
              <span class="rd">{update.description}</span>
            </span>
            <span class="rm">{update.meta}</span>
          </a>
        ))
      }
    </div>
    <div class="rgroup-label">Mapping Reports</div>
    <div class="rlist">
      {
        mappingReports.map((report, index) => (
          <a class="r" href={report.href}>
            <span class="rn">{String(index + 1).padStart(3, '0')}</span>
            <span>
              <span class="rt">{report.title}</span>
              <span class="rd">{report.description}</span>
            </span>
            <span class="rm">{report.meta}</span>
          </a>
        ))
      }
    </div>
    <div class="rgroup-label">Essays & Reflections</div>
    <div class="rlist">
      {
        essays.map((essay, index) => (
          <a class="r" href={essay.href}>
            <span class="rn">{String(index + 1).padStart(3, '0')}</span>
            <span>
              <span class="rt">{essay.title}</span>
              <span class="rd">{essay.description}</span>
            </span>
            <span class="rm">{essay.meta}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

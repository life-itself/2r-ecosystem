---
import Base from './Base.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  created?: string;
  authors?: string[];
  links?: Array<{ label: string; href: string; primary?: boolean }>;
  active?: 'pip' | 'cohere' | 'directory' | 'reports';
  headings?: Heading[];
}

const { title = 'Untitled', description, created, authors, links, active, headings = [] } = Astro.props;
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 3;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={title} description={description} active={active}>
  <article class="prose-article">
    <header class="prose-header">
      <h1 class="prose-title">{title}</h1>
      {description && <p class="prose-lede">{description}</p>}
      {
        (created || (authors && authors.length > 0)) && (
          <p class="prose-meta">
            {authors && authors.length > 0 && <span>{authors.join(', ')}</span>}
            {created && authors && authors.length > 0 && <span class="prose-meta-sep">·</span>}
            {created && <time datetime={created}>{formatDate(created)}</time>}
          </p>
        )
      }
      {
        links && links.length > 0 && (
          <div class="prose-actions">
            {links.map((link) => (
              <a class={`button ${link.primary ? 'primary' : ''}`} href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class={hasToc ? 'prose-body-with-toc' : 'prose-body'}>
      <div class="prose-body">
        <slot />
      </div>
      {hasToc && (
        <aside class="prose-toc-aside">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .prose-body-with-toc {
    display: grid;
    grid-template-columns: 1fr 13rem;
    gap: 3rem;
    align-items: start;
  }

  /* TOC needs design/alignment work before enabling — see https://github.com/life-itself/2r-ecosystem/issues/8 */
  .prose-toc-aside {
    display: none;
  }

  @media (max-width: 900px) {
    .prose-body-with-toc {
      grid-template-columns: 1fr;
    }
  }
</style>

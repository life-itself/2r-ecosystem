---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Second Renaissance Ecosystem',
  description = 'Mapping an emerging ecosystem of change agents working on paradigmatic, integrative, and pragmatic approaches to social change.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --background: #f8f7f2;
        --surface: #ffffff;
        --text: #1e1d1a;
        --muted: #666058;
        --border: #ded8cc;
        --accent: #8b3f2f;
        --accent-strong: #5f2b21;
        --link: #245c63;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        line-height: 1.55;
      }

      a {
        color: var(--link);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: rgba(248, 247, 242, 0.94);
      }

      .nav {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        color: var(--text);
        font-weight: 700;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: var(--muted);
        font-size: 0.95rem;
        text-decoration: none;
      }

      .nav-links a:hover,
      .nav-links a:focus {
        color: var(--accent-strong);
      }

      main {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 56px 0 72px;
      }

      h1,
      h2,
      h3 {
        line-height: 1.15;
        letter-spacing: 0;
      }

      h1 {
        max-width: 760px;
        margin: 0 0 18px;
        font-size: clamp(2.25rem, 8vw, 4.75rem);
      }

      h2 {
        margin-top: 44px;
        font-size: 1.65rem;
      }

      p {
        max-width: 760px;
      }

      .lede {
        color: var(--muted);
        font-size: 1.2rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
        margin-top: 28px;
      }

      .card {
        min-height: 100%;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: inherit;
        text-decoration: none;
      }

      .card:hover,
      .card:focus-within {
        border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
      }

      .card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: #ece7dd;
      }

      .card-body {
        padding: 18px;
      }

      .card h3 {
        margin: 0 0 8px;
        color: var(--text);
        font-size: 1.05rem;
      }

      .card p,
      .muted {
        color: var(--muted);
      }

      .profile-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px 18px;
        padding: 0;
        list-style: none;
      }

      .stat {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        margin: 20px 0 12px;
        padding: 10px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
      }

      .stat strong {
        color: var(--accent-strong);
        font-size: 1.6rem;
      }

      @media (max-width: 620px) {
        .nav {
          align-items: flex-start;
          flex-direction: column;
          justify-content: center;
          padding: 16px 0;
          gap: 10px;
        }

        main {
          padding-top: 36px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">Second Renaissance Ecosystem</a>
        <div class="nav-links">
          <a href="/pip/">PIP</a>
          <a href="/cohere/">Cohere+</a>
          <a href="https://secondrenaissance.net/">Second Renaissance</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

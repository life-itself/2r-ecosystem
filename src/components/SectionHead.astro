---
interface Props {
  number: string;
  label: string;
  title: string;
  description?: string;
}

const { number, label, title, description } = Astro.props;
---

<div class="sec-head">
  <div>
    <div class="sec-num">{number} / {label}</div>
    <h2>{title}</h2>
  </div>
  {description && <p>{description}</p>}
</div>

<figure class="figure" aria-label="Topic constellation reference plate">
  <div class="frame">
    <svg id="constellation" viewBox="0 0 600 500" role="img" aria-labelledby="constellation-title">
      <title id="constellation-title">Constellation of ecosystem topics and relationships</title>
    </svg>
    <span class="corner">PIP / FIELD</span>
    <span class="cap">Reference plate · relational clusters</span>
  </div>
</figure>

<script>
  const svg = document.querySelector<SVGSVGElement>('#constellation');
  const ns = 'http://www.w3.org/2000/svg';

  function mulberry32(seed: number) {
    return function random() {
      let t = (seed += 0x6d2b79f5);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function el(name: string, attrs: Record<string, string | number>) {
    const node = document.createElementNS(ns, name);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
    return node;
  }

  if (svg) {
    const random = mulberry32(1439);
    const clusters = [
      { label: 'governance', x: 155, y: 135, n: 9 },
      { label: 'ecology', x: 420, y: 105, n: 8 },
      { label: 'spirituality', x: 485, y: 280, n: 8 },
      { label: 'community', x: 320, y: 365, n: 10 },
      { label: 'politics', x: 145, y: 315, n: 7 },
      { label: 'development', x: 300, y: 225, n: 11 },
    ];
    const points: Array<{ x: number; y: number; cluster: number; bridge: boolean }> = [];

    svg.append(el('circle', { class: 'chalo', cx: 300, cy: 245, r: 190 }));
    svg.append(el('circle', { class: 'chalo', cx: 300, cy: 245, r: 116 }));

    clusters.forEach((cluster, clusterIndex) => {
      for (let i = 0; i < cluster.n; i += 1) {
        const angle = random() * Math.PI * 2;
        const radius = 16 + random() * 58;
        points.push({
          x: cluster.x + Math.cos(angle) * radius,
          y: cluster.y + Math.sin(angle) * radius,
          cluster: clusterIndex,
          bridge: random() > 0.78,
        });
      }
      const label = el('text', {
        class: 'clabel',
        x: cluster.x - 34,
        y: cluster.y - 68,
      });
      label.textContent = cluster.label;
      svg.append(label);
    });

    points.forEach((point, index) => {
      points.slice(index + 1).forEach((other) => {
        const sameCluster = point.cluster === other.cluster;
        const distance = Math.hypot(point.x - other.x, point.y - other.y);
        const isBridge = point.bridge && other.bridge && !sameCluster && random() > 0.72;
        if ((sameCluster && distance < 82 && random() > 0.42) || isBridge) {
          svg.prepend(
            el('line', {
              class: isBridge ? 'link acc' : 'link',
              x1: point.x,
              y1: point.y,
              x2: other.x,
              y2: other.y,
            }),
          );
        }
      });
    });

    points.forEach((point) => {
      svg.append(
        el('circle', {
          class: point.bridge ? 'node acc' : random() > 0.84 ? 'node lg' : 'node',
          cx: point.x,
          cy: point.y,
          r: point.bridge ? 4.2 : 2.7 + random() * 2.4,
        }),
      );
    });
  }
</script>
